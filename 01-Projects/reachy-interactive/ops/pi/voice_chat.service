[Unit]
Description=Reachy hallway voice loop (auto-restart)
# NO After= here. Any After= (network-online.target, respeaker_gain.service,
# which are themselves After=multi-user.target) created a systemd ordering
# CYCLE, so the boot deleted the start job and the demo never came up.
# ExecStartPre waits for the broker, so readiness is fully covered without
# ordering deps. Restart limit off so Restart=always never gives up.
StartLimitIntervalSec=0

[Service]
User=pi
WorkingDirectory=/home/pi/Documents
# pip3 install --user 로 깐 edge-tts 등이 ~/.local/bin 에 있다. systemd 기본
# PATH 에는 그 디렉터리가 없어서, 넣어 주지 않으면 코드가 못 찾고 더 기계적인
# 목소리(gtts)로 조용히 내려간다.
Environment=PATH=/home/pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONUNBUFFERED=1
# Wait for the robot's 3 FTDI Luos gates to enumerate - at boot voice_chat
# used to start before /dev/ttyUSB* existed and crash-loop 3x (Restart caught
# it, but ugly). ttyUSB2 present => all three are up.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/ttyUSB2 ] && exit 0; sleep 1; done; exit 0'
# Then wait up to 5 min for the tunnel+broker so the first turn (and filler
# synthesis) has a network; start anyway if it never comes (degraded mode).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -sf -m 3 http://127.0.0.1:8080/health >/dev/null && exit 0; sleep 5; done; exit 0'
# --gaze-tilt 0: 시선 값이 곧 실제로 보는 곳이 되게 한다.
# 코드 기본값(-0.15)은 바닥을 봤고, 한동안 쓰던 +0.15 는 반대로 천장을 봤다
# (수집된 사진이 배관과 천장 위주였다). 목을 굳히고 높이를 바꿔 가며 찍어 보니
# z=-0.05 에서 복도와 사람 눈높이가 화면 가운데 왔다. 그래서 기울기는 0 으로
# 두고, 정면은 say_and_move.NEUTRAL_GAZE = (0, -0.05) 로 정의한다.
#
# 수면 모드: 불이 꺼지고 사람도 없으면 스스로는 아무 소리도 내지 않고
# 움직이지도 않는다(통신은 그대로). 문턱값은 현장 실측으로 정한다 -
# brightness_report.sh 로 밤낮 값을 보고 그 사이에 놓는다.
# 실측(불 켜진 복도): 0.577. 밤 값을 확인한 뒤 필요하면 조정한다.
# --quiet-hours 20-8 = 근무시간 아침 8시~저녁 8시에만 동작한다. 카메라가 없을
# 때의 안전망이기도 하다: 퇴근하며 모터 전원을 내리면 로봇 연결이 통째로 실패해
# 카메라도 없는데, 그때가 바로 재워야 할 밤이다.
ExecStart=/usr/bin/python3 /home/pi/Documents/voice_chat.py --motions --hallway --stt auto --fixed-energy 900 --gaze-tilt 0 --camera-index main --collect-people \
  --dark-below 0.15 --light-above 0.25 --sleep-after 180 --quiet-hours 20-8 \
  --url http://127.0.0.1:8080 --token reachy2019
# A visitor's genuine goodbye no longer exits in hallway mode, but any crash
# or manual stop word in non-hallway runs just restarts the loop.
Restart=always
RestartSec=5
StandardOutput=append:/home/pi/reachy_logs/voice_chat.log
StandardError=append:/home/pi/reachy_logs/voice_chat.log

[Install]
WantedBy=multi-user.target
