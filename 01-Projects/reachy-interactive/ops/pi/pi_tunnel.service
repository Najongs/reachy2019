# Pi <-> DGX 상시 SSH 터널. 윈도우 중계 불필요.
#   -L 8080 : Pi 에서 127.0.0.1:8080 = DGX 브로커
#   -R 2222 : DGX 에서 ssh -p 2222 pi@localhost = 이 Pi (역방향 접속/파일 배포용)
#   -R 8090/6171 : DGX(및 외부에서 DGX 경유)에서 뷰어/미러 확인용
# 설치 (Pi에서):
#   sudo cp pi_tunnel.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pi_tunnel
#
# ExitOnForwardFailure 는 일부러 쓰지 않는다: Pi 가 불결하게 끊기면 DGX sshd 가
# 죽은 세션과 그 -R 포트를 한참 붙들고 있는데, 그 플래그가 있으면 -R 바인딩 실패
# 하나로 터널 전체(로봇이 실제로 쓰는 -L 8080 포함)가 죽는다. 빼두면 -L 은 항상
# 올라오고, -R 은 죽은 세션이 정리되는 대로 붙는다.
# 근본 해결은 DGX 쪽 sshd 의 ClientAliveInterval (ops/sshd_keepalive.conf).
[Unit]
Description=SSH tunnel to DGX broker (Reachy)
Wants=network-online.target
After=network-online.target

[Service]
User=pi
ExecStart=/usr/bin/ssh -N \
  -o ServerAliveInterval=15 -o ServerAliveCountMax=2 \
  -o StrictHostKeyChecking=accept-new \
  -i /home/pi/.ssh/dgx_tunnel \
  -p 20411 \
  -L 8080:localhost:8080 \
  -R 2222:localhost:22 \
  -R 8090:localhost:8090 \
  -R 6171:localhost:6171 \
  -R 6172:localhost:6172 \
  kiro-ai@210.183.240.125
Restart=always
# 10초였다. 터널이 끊긴 그 10초 동안 8080 이 아예 안 열려 있어서, 그 사이
# 말을 건 사람은 지연 0.0초로 "음, 잘 모르겠어요" 를 들었다(실패한 대화
# 18건 중 10건). 2초로 줄이고, 로봇 쪽에서도 몇 초는 기다렸다 다시 묻는다
# (llm_client.CONNECT_RETRIES).
RestartSec=2

[Install]
WantedBy=multi-user.target
